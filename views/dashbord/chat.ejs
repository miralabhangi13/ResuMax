<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Resume Chat | ResuMax</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Custom CSS -->
    <style>
        :root {
            --bs-primary: #4F46E5;
            --primary-blue: #3B82F6;
            --primary-purple: #8B5CF6;
            --bg-light: #f8fafc;
            --text-dark: #0f172a;
            --text-muted: #64748b;
        }

        body,
        html {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-light);
            color: var(--text-dark);
            height: 100vh;
            overflow: hidden;
            -webkit-font-smoothing: antialiased;
        }

        /* Layout Grid */
        .chat-wrapper {
            display: grid;
            grid-template-columns: 280px 1fr;
            height: 100vh;
        }

        @media (max-width: 991.98px) {
            .chat-wrapper {
                grid-template-columns: 1fr;
            }

            .chat-sidebar {
                display: none;
                /* Can be toggled with JS on mobile if needed */
            }
        }

        /* Sidebar Style */
        .chat-sidebar {
            background: #ffffff;
            border-right: 1px solid rgba(226, 232, 240, 0.8);
            display: flex;
            flex-direction: column;
            padding: 1.5rem;
            z-index: 10;
        }

        .resume-select-item {
            padding: 0.75rem 1rem;
            border-radius: 0.75rem;
            border: 1px solid #e2e8f0;
            background: #f8fafc;
            color: var(--text-dark);
            text-decoration: none;
            font-size: 0.875rem;
            font-weight: 500;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 0.5rem;
        }

        .resume-select-item:hover,
        .resume-select-item.active {
            background: rgba(79, 70, 229, 0.05);
            border-color: var(--bs-primary);
            color: var(--bs-primary);
        }

        /* Main Chat Area */
        .chat-main {
            display: flex;
            flex-direction: column;
            height: 100vh;
            background: #ffffff;
            position: relative;
        }

        .chat-header {
            padding: 1rem 1.5rem;
            border-bottom: 1px solid #e2e8f0;
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(8px);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        /* Message Stream Window */
        .chat-messages {
            flex-grow: 1;
            overflow-y: auto;
            padding: 2rem;
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            scroll-behavior: smooth;
        }

        /* Message Bubbles */
        .message {
            display: flex;
            gap: 1rem;
            max-width: 80%;
        }

        @media (max-width: 768px) {
            .message {
                max-width: 95%;
            }
        }

        .message.user {
            margin-left: auto;
            flex-direction: row-reverse;
        }

        .message-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            font-size: 1rem;
        }

        .message.ai .message-avatar {
            background: linear-gradient(135deg, var(--primary-blue), var(--primary-purple));
            color: white;
            box-shadow: 0 4px 6px rgba(79, 70, 229, 0.2);
        }

        .message.user .message-avatar {
            background: #e2e8f0;
            color: var(--text-dark);
        }

        .message-bubble {
            padding: 1rem 1.25rem;
            border-radius: 1rem;
            font-size: 0.95rem;
            line-height: 1.5;
        }

        .message.ai .message-bubble {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            color: var(--text-dark);
            border-top-left-radius: 0.25rem;
        }

        /* Markdown inside AI replies */
        .message-bubble.markdown > :first-child { margin-top: 0; }
        .message-bubble.markdown > :last-child { margin-bottom: 0; }
        .message-bubble.markdown p { margin: 0 0 0.6rem; }
        .message-bubble.markdown ul,
        .message-bubble.markdown ol { padding-left: 1.25rem; margin: 0 0 0.6rem; }
        .message-bubble.markdown li { margin-bottom: 0.45rem; }
        .message-bubble.markdown li:last-child { margin-bottom: 0; }
        .message-bubble.markdown strong { color: var(--bs-primary); font-weight: 600; }
        .message-bubble.markdown h1,
        .message-bubble.markdown h2,
        .message-bubble.markdown h3,
        .message-bubble.markdown h4 { font-size: 1rem; font-weight: 700; margin: 0.75rem 0 0.4rem; }
        .message-bubble.markdown code { background: #eef2ff; color: #4338ca; padding: 0.1rem 0.35rem; border-radius: 0.3rem; font-size: 0.85em; }
        .message-bubble.markdown pre { background: #0f172a; color: #e2e8f0; padding: 0.75rem 1rem; border-radius: 0.6rem; overflow-x: auto; }
        .message-bubble.markdown pre code { background: none; color: inherit; padding: 0; }
        .message-bubble.markdown table { width: 100%; border-collapse: collapse; margin: 0 0 0.6rem; font-size: 0.9rem; }
        .message-bubble.markdown th,
        .message-bubble.markdown td { border: 1px solid #e2e8f0; padding: 0.35rem 0.6rem; text-align: left; }
        .message-bubble.markdown a { color: var(--bs-primary); }

        .message.user .message-bubble {
            background: linear-gradient(135deg, var(--primary-blue), var(--primary-purple));
            color: white;
            border-top-right-radius: 0.25rem;
        }

        /* Chat Input Footer */
        .chat-footer {
            padding: 1.5rem;
            border-top: 1px solid #e2e8f0;
            background: #ffffff;
        }

        .chat-input-wrapper {
            display: flex;
            align-items: center;
            background: #f8fafc;
            border: 2px solid #e2e8f0;
            border-radius: 1rem;
            padding: 0.5rem 0.75rem;
            transition: all 0.2s;
        }

        .chat-input-wrapper:focus-within {
            border-color: var(--bs-primary);
            background: #ffffff;
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
        }

        .chat-input {
            border: none;
            background: transparent;
            width: 100%;
            padding: 0.5rem;
            font-size: 0.95rem;
            color: var(--text-dark);
            outline: none;
        }

        .send-btn {
            background: linear-gradient(135deg, var(--primary-blue), var(--primary-purple));
            border: none;
            color: white;
            width: 40px;
            height: 40px;
            border-radius: 0.75rem;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: transform 0.2s;
            flex-shrink: 0;
        }

        .send-btn:hover {
            transform: scale(1.05);
        }

        /* Quick Prompt Suggestions */
        .prompt-chips {
            display: flex;
            gap: 0.5rem;
            overflow-x: auto;
            padding-bottom: 0.5rem;
            margin-bottom: 1rem;
        }

        .prompt-chip {
            background: #f1f5f9;
            border: 1px solid #e2e8f0;
            border-radius: 2rem;
            padding: 0.35rem 0.85rem;
            font-size: 0.8rem;
            color: var(--text-muted);
            white-space: nowrap;
            cursor: pointer;
            transition: all 0.2s;
        }

        .prompt-chip:hover {
            background: rgba(79, 70, 229, 0.05);
            border-color: var(--bs-primary);
            color: var(--bs-primary);
        }
    </style>
</head>

<body>

    <div class="chat-wrapper">

        <!-- Sidebar: Resume Context Selector -->
        <div class="chat-sidebar">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <a href="/dashbord" class="text-decoration-none fw-bold fs-5 text-gradient">ResuMax AI</a>
                <a href="/dashbord" class="btn btn-sm btn-light border rounded-pill px-2 text-muted"
                    title="Back to Dashboard">
                    <i class="bi bi-x-lg"></i>
                </a>
            </div>

            <p class="text-muted small fw-semibold text-uppercase mb-3">Active Context</p>

            <div class="overflow-y-auto flex-grow-1 pe-1">
                <% if (typeof resumes !=='undefined' && resumes.length> 0) { %>
                    <% resumes.forEach((resItem, idx)=> { %>
                        <a href="/resume/chat/<%= resItem._id %>"
                            class="resume-select-item <%= (selectedResume && selectedResume._id.toString() === resItem._id.toString()) ? 'active' : '' %>"
                            data-id="<%= resItem._id %>">
                            <i class="bi bi-file-earmark-pdf-fill text-danger fs-5"></i>
                            <div class="overflow-hidden">
                                <div class="text-truncate fw-semibold">Resume <%= idx + 1 %>
                                </div>
                                <div class="text-muted" style="font-size: 0.7rem;">
                                    <%= new Date(resItem.uploadedAt).toLocaleDateString() %>
                                </div>
                            </div>
                        </a>
                        <% }) %>
                            <% } else { %>
                                <div class="text-center py-4 text-muted small">
                                    <p>No resumes found.</p>
                                    <a href="/resume/upload" class="btn btn-sm btn-primary rounded-pill w-100">Upload
                                        Resume</a>
                                </div>
                                <% } %>
            </div>

            <div class="pt-3 border-top mt-auto">
                <a href="/dashbord" class="btn btn-light w-100 border text-dark fw-medium rounded-pill py-2">
                    <i class="bi bi-grid me-2"></i> Dashboard
                </a>
            </div>
        </div>

        <!-- Main Chat Panel -->
        <div class="chat-main">

            <!-- Chat Header -->
            <div class="chat-header">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center"
                        style="width: 40px; height: 40px;">
                        <i class="bi bi-robot fs-5"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0">ResuMax Career Assistant</h6>
                        <span class="text-muted small">Ask me anything about your resume, missing skills, or interview
                            prep.</span>
                    </div>
                </div>
            </div>

            <!-- Messages Box -->
            <div class="chat-messages" id="chatMessages">
                <!-- Welcome AI Message -->
                <div class="message ai">
                    <div class="message-avatar">
                        <i class="bi bi-robot"></i>
                    </div>
                    <div class="message-bubble shadow-sm">
                        Hello! <%= user.username %>. I've loaded your resume context. How can I help you improve your
                            profile or prepare for interviews today?
                    </div>
                </div>
            </div>

            <!-- Chat Footer Input -->
            <div class="chat-footer">

                <!-- Quick Prompt Chips -->
                <div class="prompt-chips">
                    <div class="prompt-chip" onclick="sendPresetPrompt('How can I improve my ATS score?')">⚡ How to
                        improve ATS score?</div>
                    <div class="prompt-chip"
                        onclick="sendPresetPrompt('Suggest stronger action verbs for my experience bullets.')">💪
                        Suggest action verbs</div>
                    <div class="prompt-chip"
                        onclick="sendPresetPrompt('What technical questions will recruiters ask based on this resume?')">
                        🎯 Mock interview questions</div>
                    <div class="prompt-chip" onclick="sendPresetPrompt('Write a professional summary for my profile.')">
                        📝 Write a professional summary</div>
                </div>

                <form id="chatForm" class="chat-input-wrapper">
                    <input type="text" id="chatInput" class="chat-input" placeholder="Ask AI about your resume..."
                        autocomplete="off" required>
                    <button type="submit" class="send-btn" id="sendBtn">
                        <i class="bi bi-send-fill"></i>
                    </button>
                </form>
            </div>

        </div>

    </div>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Markdown rendering for AI replies -->
    <script src="https://cdn.jsdelivr.net/npm/marked@12.0.2/marked.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/dompurify@3.1.6/dist/purify.min.js"></script>

    <!-- Chat Frontend Logic -->
    <script>
        const chatForm = document.getElementById('chatForm');
        const chatInput = document.getElementById('chatInput');
        const chatMessages = document.getElementById('chatMessages');

        // Helper to append message to the stream
        function appendMessage(sender, text) {
            const isAi = sender === 'ai';
            const messageDiv = document.createElement('div');
            messageDiv.className = `message ${sender}`;

            messageDiv.innerHTML = `
                <div class="message-avatar">
                    <i class="bi ${isAi ? 'bi-robot' : 'bi-person-fill'}"></i>
                </div>
                <div class="message-bubble shadow-sm${isAi ? ' markdown' : ''}">
                    ${isAi ? renderMarkdown(text) : escapeHtml(text)}
                </div>
            `;

            chatMessages.appendChild(messageDiv);
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        // Render AI Markdown to safe HTML (falls back to escaped text)
        function renderMarkdown(text) {
            const source = String(text ?? "");
            if (window.marked && window.DOMPurify) {
                return DOMPurify.sanitize(marked.parse(source, { breaks: true, gfm: true }));
            }
            return escapeHtml(source).replace(/\n/g, "<br>");
        }

        // Simple HTML escape for safety
        function escapeHtml(text) {
            const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
            return String(text ?? "").replace(/[&<>"']/g, function (m) { return map[m]; });
        }

        // Send preset suggestion chip
        function sendPresetPrompt(promptText) {
            chatInput.value = promptText;
            chatForm.dispatchEvent(new Event('submit'));
        }

        // Handle Form Submission
        chatForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const messageText = chatInput.value.trim();
            if (!messageText) return;

            // 1. Append User Message
            appendMessage('user', messageText);
            chatInput.value = '';

            // 2. Add Typing Indicator / Loading State
            const loadingId = 'loading-' + Date.now();
            const loadingDiv = document.createElement('div');
            loadingDiv.className = 'message ai';
            loadingDiv.id = loadingId;
            loadingDiv.innerHTML = `
                <div class="message-avatar"><i class="bi bi-robot"></i></div>
                <div class="message-bubble shadow-sm text-muted">
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span> Thinking...
                </div>
            `;
            chatMessages.appendChild(loadingDiv);
            chatMessages.scrollTop = chatMessages.scrollHeight;

            try {
                // 3. Send request to your Express backend API route
                const resumeId = "<%= selectedResume._id %>";

                const response = await fetch(`/resume/chat/${resumeId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        message: messageText
                    })
                });
                const data = await response.json();

                // Remove loading bubble
                document.getElementById(loadingId).remove();

                if (response.ok) {
                    appendMessage('ai', data.reply);
                } else {
                    appendMessage('ai', "Sorry, I encountered an error processing your request. Please try again.");
                }

            } catch (err) {
                console.error("Chat error:", err);
                document.getElementById(loadingId).remove();
                appendMessage('ai', "Network error. Please check your connection.");
            }
        });
    </script>
</body>

</html>