<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify Email | ResuMax</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    
    <!-- Custom CSS -->
    <style>
        :root {
            --bs-primary: #4F46E5;
            --primary-blue: #3B82F6;
            --primary-purple: #8B5CF6;
            --text-purple: #7C3AED;
            --surface-color: #ffffff;
            --bg-light: #f8fafc;
        }

        body {
            font-family: 'Inter', sans-serif;
            color: #1e293b;
            background-color: var(--bg-light);
            position: relative;
            overflow-x: hidden;
            min-height: 100vh;
        }

        /* Typography & Gradients */
        .text-gradient {
            background: linear-gradient(135deg, var(--primary-blue), var(--primary-purple));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .btn-gradient {
            background: linear-gradient(135deg, var(--primary-blue), var(--primary-purple));
            border: none;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            color: white;
        }

        .btn-gradient:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(79, 70, 229, 0.3);
            color: white;
        }

        /* Background Blobs */
        .blob {
            position: absolute;
            filter: blur(80px);
            z-index: 0;
            border-radius: 50%;
            opacity: 0.4;
        }

        .shape-1 {
            top: -10%;
            left: -10%;
            width: 400px;
            height: 400px;
            background: var(--primary-blue);
        }

        .shape-2 {
            bottom: -10%;
            right: -10%;
            width: 350px;
            height: 350px;
            background: var(--primary-purple);
        }

        /* Auth Card */
        .auth-container {
            position: relative;
            z-index: 1;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
        }

        .auth-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            border-radius: 1.5rem;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            width: 100%;
            max-width: 450px;
            padding: 2.5rem;
        }

        .hover-link {
            color: var(--bs-primary);
            text-decoration: none;
            font-weight: 500;
            transition: color 0.2s;
        }

        .hover-link:hover {
            color: var(--primary-purple);
            text-decoration: underline;
        }

        /* Icon wrapper for the header */
        .icon-circle-header {
            width: 56px;
            height: 56px;
            background: rgba(59, 130, 246, 0.1);
            color: var(--primary-blue);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.25rem auto;
            font-size: 1.5rem;
        }

        /* OTP Inputs */
        .otp-inputs {
            display: flex;
            gap: 0.5rem;
            justify-content: center;
            margin-bottom: 1.5rem;
        }

        .otp-input {
            width: 3rem;
            height: 3.5rem;
            text-align: center;
            font-size: 1.25rem;
            font-weight: 600;
            border-radius: 0.5rem;
            border: 1px solid #cbd5e1;
            background-color: #f8fafc;
            color: #0f172a;
            transition: all 0.2s;
        }

        .otp-input:focus {
            background-color: #ffffff;
            border-color: var(--primary-purple);
            box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.1);
            outline: none;
        }

        @media (max-width: 400px) {
            .otp-input {
                width: 2.5rem;
                height: 3rem;
                font-size: 1rem;
            }
        }

        /* Timer Styles */
        .timer-text {
            font-variant-numeric: tabular-nums;
            font-weight: 600;
            color: var(--bs-primary);
        }

        /* Custom Alert Notification */
        .custom-toast {
            position: fixed;
            top: 24px;
            left: 50%;
            transform: translate(-50%, -150%);
            background-color: #ffffff;
            padding: 1rem 1.25rem;
            border-radius: 0.75rem;
            box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1), 0 8px 10px -6px rgba(0,0,0,0.1);
            display: flex;
            align-items: center;
            gap: 0.75rem;
            z-index: 9999;
            width: 90%;
            max-width: 400px;
            transition: transform 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
            border: 1px solid rgba(239, 68, 68, 0.2);
            pointer-events: none;
        }

        .custom-toast.show {
            transform: translate(-50%, 0);
        }

        .custom-toast .icon-wrapper {
            background-color: #fef2f2;
            color: #ef4444;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .custom-toast .message {
            color: #0f172a;
            font-size: 0.875rem;
            font-weight: 500;
            line-height: 1.4;
        }

        .resend-btn {
            background: none;
            border: none;
            padding: 0;
            font: inherit;
            cursor: pointer;
        }
    </style>
</head>
<body>

    <!-- Custom Toast Notification -->
    <div id="customToast" class="custom-toast">
        <div class="icon-wrapper">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </div>
        <div class="message" id="toastMessage"></div>
    </div>

    <!-- Background decorative elements -->
    <div class="blob shape-1"></div>
    <div class="blob shape-2"></div>

    <div class="auth-container">
        <div class="auth-card">
            <!-- Header -->
            <div class="text-center mb-4">
                <div class="icon-circle-header">
                    <i class="bi bi-envelope-paper-fill"></i>
                </div>
                <h1 class="h4 fw-bold text-dark mb-2">Check your email</h1>
                <p class="text-secondary small mb-1">We sent a 6-digit verification code to:</p>
                <p class="fw-semibold text-dark"><%= typeof email !== 'undefined' ? email : 'your email address' %></p>
            </div>

            <!-- OTP Form -->
            <form action="/verify-otp" method="POST" id="otpForm">
                
                <!-- Hidden inputs for backend processing -->
                <input type="hidden" name="email" value="<%= email %>">
                <input type="hidden" name="otp" id="finalOtpInput">

                <!-- 6-Digit OTP Inputs -->
                <div class="otp-inputs" id="otpContainer">
                    <input type="text" class="otp-input" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code" required autofocus>
                    <input type="text" class="otp-input" maxlength="1" inputmode="numeric" pattern="[0-9]*" required>
                    <input type="text" class="otp-input" maxlength="1" inputmode="numeric" pattern="[0-9]*" required>
                    <input type="text" class="otp-input" maxlength="1" inputmode="numeric" pattern="[0-9]*" required>
                    <input type="text" class="otp-input" maxlength="1" inputmode="numeric" pattern="[0-9]*" required>
                    <input type="text" class="otp-input" maxlength="1" inputmode="numeric" pattern="[0-9]*" required>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn btn-gradient w-100 rounded-pill py-2 fw-medium mb-4">
                    Verify Code
                </button>
            </form>

            <!-- Timer and Resend Logic -->
            <div class="text-center small">
                <!-- Shows while timer is ticking -->
                <div id="timerContainer" class="text-secondary">
                    Resend code in <span class="timer-text" id="countdownTimer">01:00</span>
                </div>
                
                <!-- Shows when timer hits 0 -->
                <div id="resendContainer" class="d-none">
                    <form action="/resend-otp" method="POST" class="d-inline">
                        <input type="hidden" name="email" value="<%= typeof email !== 'undefined' ? email : '' %>">
                        <span class="text-secondary">Didn't receive it? </span>
                        <button type="submit" class="resend-btn hover-link fw-bold">Click to resend</button>
                    </form>
                </div>
            </div>

            <!-- Back to Login Link -->
            <div class="text-center mt-4 pt-3 border-top">
                <a href="/login" class="hover-link small d-inline-flex align-items-center gap-1">
                    <i class="bi bi-arrow-left"></i> Back to log in
                </a>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Custom Logic -->
    <script>
        // --- 1. Custom Toast Logic ---
        let toastTimeout;
        function showToast(message) {
            const errorMsg = Array.isArray(message) ? message[0] : message;
            const toast = document.getElementById('customToast');
            const msgEl = document.getElementById('toastMessage');
            
            msgEl.textContent = errorMsg;
            toast.classList.add('show');
            
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.remove('show');
            }, 3500);
        }

        // --- 2. OTP Input Auto-Advance Logic ---
        const otpInputs = document.querySelectorAll('.otp-input');
        const finalOtpInput = document.getElementById('finalOtpInput');
        const otpForm = document.getElementById('otpForm');

        otpInputs.forEach((input, index) => {
            // Restrict input to numbers only
            input.addEventListener('input', (e) => {
                e.target.value = e.target.value.replace(/[^0-9]/g, '');
                
                if (e.target.value !== '') {
                    // Move to next input if available
                    if (index < otpInputs.length - 1) {
                        otpInputs[index + 1].focus();
                    }
                }
                updateFinalOtp();
            });

            // Handle Backspace
            input.addEventListener('keydown', (e) => {
                if (e.key === 'Backspace' && e.target.value === '') {
                    // Move to previous input if current is empty
                    if (index > 0) {
                        otpInputs[index - 1].focus();
                    }
                }
            });

            // Handle Paste (allows pasting a 6 digit code into the first box)
            input.addEventListener('paste', (e) => {
                e.preventDefault();
                const pastedData = e.clipboardData.getData('text').replace(/[^0-9]/g, '').slice(0, 6);
                
                if (pastedData) {
                    for (let i = 0; i < pastedData.length; i++) {
                        if (i < otpInputs.length) {
                            otpInputs[i].value = pastedData[i];
                        }
                    }
                    // Focus the next empty box or the last box
                    const nextIndex = Math.min(pastedData.length, otpInputs.length - 1);
                    otpInputs[nextIndex].focus();
                    updateFinalOtp();
                }
            });
        });

        // Combine all 6 inputs into the hidden input before form submit
        function updateFinalOtp() {
            let otpString = '';
            otpInputs.forEach(input => {
                otpString += input.value;
            });
            finalOtpInput.value = otpString;
        }

        otpForm.addEventListener('submit', (e) => {
            updateFinalOtp();
            if (finalOtpInput.value.length !== 6) {
                e.preventDefault();
                showToast("Please enter the complete 6-digit code.");
            }
        });

        // --- 3. Timer Logic ---
        let timeLeft = 60; // 60 seconds
        const timerElement = document.getElementById('countdownTimer');
        const timerContainer = document.getElementById('timerContainer');
        const resendContainer = document.getElementById('resendContainer');

        const countdown = setInterval(() => {
            timeLeft--;
            
            // Format seconds with leading zero if needed
            const seconds = timeLeft < 10 ? '0' + timeLeft : timeLeft;
            timerElement.textContent = '00:' + seconds;

            if (timeLeft <= 0) {
                clearInterval(countdown);
                timerContainer.classList.add('d-none');
                resendContainer.classList.remove('d-none');
            }
        }, 1000);
    </script>

    <!-- EJS Logic to Catch Backend Errors (e.g. "Invalid OTP") -->
    <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                showToast(<%- JSON.stringify(error) %>);
            });
        </script>
    <% } else if (typeof success !== 'undefined' && success && success.length > 0) { %>
        <!-- Optional: If you want to show a success toast when they hit "Resend" -->
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                const toast = document.getElementById('customToast');
                toast.querySelector('.icon-wrapper').innerHTML = '<i class="bi bi-check-circle-fill"></i>';
                toast.querySelector('.icon-wrapper').style.backgroundColor = '#d1fae5';
                toast.querySelector('.icon-wrapper').style.color = '#10b981';
                toast.style.borderColor = 'rgba(16, 185, 129, 0.2)';
                showToast(<%- JSON.stringify(success) %>);
            });
        </script>
    <% } %>
</body>
</html>