<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password | ResuMax</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    
    <!-- Custom CSS -->
    <style>
        :root {
            --bs-primary: #4F46E5;
            --primary-blue: #3B82F6;
            --primary-purple: #8B5CF6;
            --text-purple: #7C3AED;
            --surface-color: #ffffff;
            --bg-light: #f8fafc;
        }

        body {
            font-family: 'Inter', sans-serif;
            color: #1e293b;
            background-color: var(--bg-light);
            position: relative;
            overflow-x: hidden;
            min-height: 100vh;
        }

        /* Typography & Gradients */
        .text-gradient {
            background: linear-gradient(135deg, var(--primary-blue), var(--primary-purple));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .btn-gradient {
            background: linear-gradient(135deg, var(--primary-blue), var(--primary-purple));
            border: none;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            color: white;
        }

        .btn-gradient:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(79, 70, 229, 0.3);
            color: white;
        }

        /* Background Blobs */
        .blob {
            position: absolute;
            filter: blur(80px);
            z-index: 0;
            border-radius: 50%;
            opacity: 0.4;
        }

        .shape-1 {
            top: -10%;
            left: -10%;
            width: 400px;
            height: 400px;
            background: var(--primary-blue);
        }

        .shape-2 {
            bottom: -10%;
            right: -10%;
            width: 350px;
            height: 350px;
            background: var(--primary-purple);
        }

        /* Auth Card */
        .auth-container {
            position: relative;
            z-index: 1;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
        }

        .auth-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            border-radius: 1.5rem;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            width: 100%;
            max-width: 450px;
            padding: 2.5rem;
        }

        /* Custom Inputs */
        .form-control {
            padding: 0.75rem 1rem;
            border-radius: 0.5rem;
            border: 1px solid #cbd5e1;
            background-color: #f8fafc;
            transition: all 0.2s;
        }

        .form-control:focus {
            background-color: #ffffff;
            border-color: var(--primary-purple);
            box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.1);
        }

        .form-label {
            font-weight: 500;
            font-size: 0.875rem;
            color: #475569;
            margin-bottom: 0.5rem;
        }

        .hover-link {
            color: var(--bs-primary);
            text-decoration: none;
            font-weight: 500;
            transition: color 0.2s;
        }

        .hover-link:hover {
            color: var(--primary-purple);
            text-decoration: underline;
        }

        /* Icon wrapper for the header */
        .icon-circle-header {
            width: 56px;
            height: 56px;
            background: rgba(139, 92, 246, 0.1);
            color: var(--primary-purple);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.25rem auto;
            font-size: 1.5rem;
        }

        /* Custom Alert Notification */
        .custom-toast {
            position: fixed;
            top: 24px;
            left: 50%;
            transform: translate(-50%, -150%);
            background-color: #ffffff;
            padding: 1rem 1.25rem;
            border-radius: 0.75rem;
            box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1), 0 8px 10px -6px rgba(0,0,0,0.1);
            display: flex;
            align-items: center;
            gap: 0.75rem;
            z-index: 9999;
            width: 90%;
            max-width: 400px;
            transition: transform 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
            border: 1px solid rgba(239, 68, 68, 0.2);
            pointer-events: none;
        }

        .custom-toast.show {
            transform: translate(-50%, 0);
        }

        .custom-toast .icon-wrapper {
            background-color: #fef2f2;
            color: #ef4444;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .custom-toast .message {
            color: #0f172a;
            font-size: 0.875rem;
            font-weight: 500;
            line-height: 1.4;
        }
    </style>
</head>
<body>

    <!-- Custom Toast Notification (For backend errors like "Email not found") -->
    <div id="customToast" class="custom-toast">
        <div class="icon-wrapper">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </div>
        <div class="message" id="toastMessage"></div>
    </div>

    <!-- Background decorative elements -->
    <div class="blob shape-1"></div>
    <div class="blob shape-2"></div>

    <div class="auth-container">
        <div class="auth-card">
            <!-- Header -->
            <div class="text-center mb-4">
                <div class="icon-circle-header">
                    <i class="bi bi-key-fill"></i>
                </div>
                <h1 class="h4 fw-bold text-dark mb-2">Forgot Password?</h1>
                <p class="text-secondary small">Enter your email address and we'll send you a 6-digit verification code to reset your password.</p>
            </div>

            <!-- Email Form -->
            <form action="/forgot-password" method="POST">
                
                <!-- Email Input -->
                <div class="mb-4">
                    <label for="email" class="form-label">Email address</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-envelope"></i>
                        </span>
                        <input type="email" class="form-control border-start-0 ps-0" id="email" name="email" placeholder="name@example.com" value="<%= typeof email !== 'undefined' ? email : '' %>" required autofocus>
                    </div>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn btn-gradient w-100 rounded-pill py-2 fw-medium mb-4">
                    Send Verification Code
                </button>
            </form>

            <!-- Back to Login Link -->
            <div class="text-center">
                <a href="/login" class="hover-link small d-inline-flex align-items-center gap-1">
                    <i class="bi bi-arrow-left"></i> Back to log in
                </a>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Vanilla JS for Toast Notifications -->
    <script>
        let toastTimeout;
        function showToast(message) {
            const errorMsg = Array.isArray(message) ? message[0] : message;
            
            const toast = document.getElementById('customToast');
            const msgEl = document.getElementById('toastMessage');
            
            msgEl.textContent = errorMsg;
            toast.classList.add('show');
            
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.remove('show');
            }, 3500);
        }
    </script>

    <!-- EJS Logic to Catch Backend Errors -->
    <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                showToast(<%- JSON.stringify(error) %>);
            });
        </script>
    <% } %>
</body>
</html>