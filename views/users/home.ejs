<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ResuMax | Build Better ATS-Friendly Resumes</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    
    <!-- Custom CSS -->
    <style>
        /* Custom CSS Variables */
        :root {
            --bs-primary: #4F46E5;
            --primary-blue: #3B82F6;
            --primary-purple: #8B5CF6;
            --text-purple: #7C3AED;
            --surface-color: #ffffff;
            --bg-light: #f8fafc;
        }

        body {
            font-family: 'Inter', sans-serif;
            color: #1e293b;
            background-color: var(--surface-color);
        }

        /* Typography & Gradients */
        .text-gradient {
            background: linear-gradient(135deg, var(--primary-blue), var(--primary-purple));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .bg-gradient-custom {
            background: linear-gradient(135deg, var(--primary-blue), var(--primary-purple));
        }

        .btn-gradient {
            background: linear-gradient(135deg, var(--primary-blue), var(--primary-purple));
            border: none;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .btn-gradient:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(79, 70, 229, 0.3);
        }

        .text-purple {
            color: var(--text-purple) !important;
        }

        .bg-purple {
            background-color: var(--text-purple) !important;
        }

        .hover-primary:hover {
            color: var(--bs-primary) !important;
        }

        /* Navbar styles */
        .navbar {
            transition: all 0.3s ease;
            padding: 1.25rem 0;
            background: transparent;
        }

        .navbar.scrolled {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            padding: 0.75rem 0;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        }

        /* Hero Section */
        .hero-section {
            background: radial-gradient(circle at top right, rgba(139, 92, 246, 0.08), transparent 40%),
                        radial-gradient(circle at bottom left, rgba(59, 130, 246, 0.08), transparent 40%);
            overflow: hidden;
        }

        /* Mockup Components */
        .glass-panel {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            position: relative;
            z-index: 2;
        }

        .placeholder-line {
            height: 12px;
            background-color: #e2e8f0;
            border-radius: 6px;
        }

        .placeholder-line.title {
            height: 24px;
            background-color: #cbd5e1;
        }

        .placeholder-line.subtitle {
            height: 16px;
        }

        /* Abstract blobs for hero background */
        .blob {
            position: absolute;
            filter: blur(60px);
            z-index: 1;
            border-radius: 50%;
            opacity: 0.5;
        }

        .shape-1 {
            top: -10%;
            right: -10%;
            width: 300px;
            height: 300px;
            background: var(--primary-blue);
        }

        .shape-2 {
            bottom: -10%;
            left: -10%;
            width: 250px;
            height: 250px;
            background: var(--primary-purple);
        }

        /* Feature Cards */
        .feature-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            border: 1px solid #f1f5f9 !important;
        }

        .feature-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05), 0 10px 10px -5px rgba(0, 0, 0, 0.02) !important;
        }

        /* How It Works line connector (Desktop only) */
        @media (min-width: 992px) {
            .step-item {
                position: relative;
            }
            .step-item:not(:last-child)::after {
                content: '';
                position: absolute;
                top: 30px;
                right: -50%;
                width: 100%;
                height: 2px;
                background-color: #e2e8f0;
                z-index: -1;
            }
        }
        
        /* Social Icons */
        .social-icon-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: #f1f5f9;
            color: #475569;
            transition: all 0.3s ease;
        }
        
        .social-icon-link:hover {
            background: linear-gradient(135deg, var(--primary-blue), var(--primary-purple));
            color: white !important;
            transform: translateY(-3px);
        }
    </style>
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg fixed-top" id="mainNav">
        <div class="container">
            <a class="navbar-brand fw-bold fs-3 text-gradient" href="/">ResuMax</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0 fw-medium">
                    <li class="nav-item"><a class="nav-link" href="#home">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="#features">Features</a></li>
                    <!-- Pricing link removed since section is removed -->
                </ul>
                <div class="d-flex gap-3">
                    <a href="/login" class="btn btn-outline-dark fw-medium rounded-pill px-4">Login</a>
                    <a href="/signup" class="btn btn-gradient fw-medium rounded-pill px-4 text-white">Start for Free</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section id="home" class="hero-section">
        <div class="container">
            <div class="row align-items-center min-vh-100 pt-5">
                <div class="col-lg-6 mb-5 mb-lg-0 hero-content text-center text-lg-start">
                    <h1 class="display-3 fw-bold mb-4">Build Better <span class="text-gradient">ATS-Friendly</span> Resumes</h1>
                    <p class="lead text-secondary mb-5 pe-lg-5">
                        Upload your resume, analyze ATS compatibility, identify weak sections, and receive AI-powered suggestions to improve your resume.
                    </p>
                    <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center justify-content-lg-start">
                        <a href="/signup" class="btn btn-gradient btn-lg rounded-pill text-white px-5 shadow-sm">Start for Free</a>
                        <a href="#features" class="btn btn-light btn-lg rounded-pill px-5 border shadow-sm">Learn More</a>
                    </div>
                </div>
                
                <div class="col-lg-6 position-relative hero-mockup">
                    <div class="mockup-card glass-panel p-4 shadow-lg rounded-4 bg-white">
                        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
                            <span class="fw-bold text-secondary">Resume Preview</span>
                            <i class="bi bi-file-earmark-text text-primary fs-4"></i>
                        </div>
                        
                        <!-- Placeholder Resume Layout -->
                        <div class="placeholder-resume mb-4">
                            <div class="placeholder-line title w-50 mb-3">[Name]</div>
                            <div class="placeholder-line subtitle w-25 mb-4">[Contact Info]</div>
                            
                            <div class="fw-semibold text-secondary mb-2">[Experience]</div>
                            <div class="placeholder-line w-75 mb-2"></div>
                            <div class="placeholder-line w-100 mb-4"></div>
                            
                            <div class="fw-semibold text-secondary mb-2">[Projects]</div>
                            <div class="placeholder-line w-100 mb-2"></div>
                            <div class="placeholder-line w-50 mb-4"></div>

                            <div class="fw-semibold text-secondary mb-2">[Skills]</div>
                            <div class="placeholder-line w-75 mb-4"></div>

                            <div class="fw-semibold text-secondary mb-2">[Education]</div>
                            <div class="placeholder-line w-50 mb-2"></div>
                        </div>

                        <!-- Placeholder Stats -->
                        <div class="analysis-status p-3 bg-light rounded-3">
                            <div class="d-flex flex-column gap-3">
                                <div>
                                    <span class="d-block fw-semibold text-dark mb-1">ATS Score</span>
                                    <span class="text-muted small"><i class="bi bi-hourglass-split me-1"></i>Score will appear after analysis</span>
                                </div>
                                <div>
                                    <span class="d-block fw-semibold text-dark mb-1">Weak Areas</span>
                                    <span class="text-muted small"><i class="bi bi-shield-exclamation me-1"></i>No analysis yet</span>
                                </div>
                                <div>
                                    <span class="d-block fw-semibold text-dark mb-1">Suggestions</span>
                                    <span class="text-muted small"><i class="bi bi-lightbulb me-1"></i>Upload a resume to receive AI suggestions.</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Decorative elements -->
                    <div class="blob shape-1"></div>
                    <div class="blob shape-2"></div>
                </div>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section id="features" class="py-5 bg-light">
        <div class="container py-5">
            <div class="text-center mb-5">
                <h2 class="fw-bold mb-3">Core Features</h2>
                <p class="text-secondary">Everything you need to optimize your resume for applicant tracking systems.</p>
            </div>
            
            <div class="row g-4">
                <div class="col-md-6 col-lg-4">
                    <div class="card feature-card h-100 border-0 shadow-sm p-4 rounded-4">
                        <div class="feature-icon bg-primary bg-opacity-10 text-primary mb-3 rounded-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="bi bi-radar fs-4"></i>
                        </div>
                        <h5 class="fw-bold">ATS Analysis</h5>
                        <p class="text-secondary mb-0">Evaluate your document against standard ATS parsing rules to ensure your content is readable by screening software.</p>
                    </div>
                </div>
                
                <div class="col-md-6 col-lg-4">
                    <div class="card feature-card h-100 border-0 shadow-sm p-4 rounded-4">
                        <div class="feature-icon bg-purple bg-opacity-10 text-purple mb-3 rounded-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="bi bi-file-earmark-break fs-4"></i>
                        </div>
                        <h5 class="fw-bold">Resume Parsing</h5>
                        <p class="text-secondary mb-0">Test how standard systems extract your contact information, work history, and education blocks.</p>
                    </div>
                </div>
                
                <div class="col-md-6 col-lg-4">
                    <div class="card feature-card h-100 border-0 shadow-sm p-4 rounded-4">
                        <div class="feature-icon bg-info bg-opacity-10 text-info mb-3 rounded-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="bi bi-stars fs-4"></i>
                        </div>
                        <h5 class="fw-bold">AI Suggestions</h5>
                        <p class="text-secondary mb-0">Receive automated recommendations for phrasing, structural improvements, and formatting best practices.</p>
                    </div>
                </div>
                
                <div class="col-md-6 col-lg-4">
                    <div class="card feature-card h-100 border-0 shadow-sm p-4 rounded-4">
                        <div class="feature-icon bg-success bg-opacity-10 text-success mb-3 rounded-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="bi bi-key fs-4"></i>
                        </div>
                        <h5 class="fw-bold">Keyword Detection</h5>
                        <p class="text-secondary mb-0">Identify which industry-standard terms are present in your document and which crucial keywords might be missing.</p>
                    </div>
                </div>
                
                <div class="col-md-6 col-lg-4">
                    <div class="card feature-card h-100 border-0 shadow-sm p-4 rounded-4">
                        <div class="feature-icon bg-warning bg-opacity-10 text-warning mb-3 rounded-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="bi bi-clock-history fs-4"></i>
                        </div>
                        <h5 class="fw-bold">Resume History</h5>
                        <p class="text-secondary mb-0">Keep track of your previously analyzed documents to monitor improvements and changes over time.</p>
                    </div>
                </div>
                
                <div class="col-md-6 col-lg-4">
                    <div class="card feature-card h-100 border-0 shadow-sm p-4 rounded-4">
                        <div class="feature-icon bg-danger bg-opacity-10 text-danger mb-3 rounded-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="bi bi-cloud-download fs-4"></i>
                        </div>
                        <h5 class="fw-bold">Export Improved Resume</h5>
                        <p class="text-secondary mb-0">Download your updated and optimized document in standard, ATS-readable formats.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- How It Works Section -->
    <section class="py-5">
        <div class="container py-5">
            <div class="text-center mb-5">
                <h2 class="fw-bold mb-3">How It Works</h2>
                <p class="text-secondary">A straightforward process to optimize your resume.</p>
            </div>
            
            <div class="row position-relative g-4">
                <div class="col-lg-2 col-md-4 col-sm-6 text-center step-item">
                    <div class="step-circle mx-auto mb-3 text-white fw-bold d-flex align-items-center justify-content-center rounded-circle bg-gradient-custom shadow" style="width: 60px; height: 60px;">1</div>
                    <h6 class="fw-bold">Create an account</h6>
                </div>
                <div class="col-lg-2 col-md-4 col-sm-6 text-center step-item">
                    <div class="step-circle mx-auto mb-3 text-white fw-bold d-flex align-items-center justify-content-center rounded-circle bg-gradient-custom shadow" style="width: 60px; height: 60px;">2</div>
                    <h6 class="fw-bold">Upload your resume</h6>
                </div>
                <div class="col-lg-2 col-md-4 col-sm-6 text-center step-item">
                    <div class="step-circle mx-auto mb-3 text-white fw-bold d-flex align-items-center justify-content-center rounded-circle bg-gradient-custom shadow" style="width: 60px; height: 60px;">3</div>
                    <h6 class="fw-bold">Analyze resume</h6>
                </div>
                <div class="col-lg-2 col-md-4 col-sm-6 text-center step-item">
                    <div class="step-circle mx-auto mb-3 text-white fw-bold d-flex align-items-center justify-content-center rounded-circle bg-gradient-custom shadow" style="width: 60px; height: 60px;">4</div>
                    <h6 class="fw-bold">Review suggestions</h6>
                </div>
                <div class="col-lg-2 col-md-4 col-sm-6 text-center step-item offset-lg-1">
                    <div class="step-circle mx-auto mb-3 text-white fw-bold d-flex align-items-center justify-content-center rounded-circle bg-gradient-custom shadow" style="width: 60px; height: 60px;">5</div>
                    <h6 class="fw-bold">Improve and download</h6>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-white border-top py-5 mt-5">
        <div class="container py-4">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <a class="navbar-brand fw-bold fs-4 text-gradient d-inline-block mb-3" href="/">ResuMax</a>
                    <p class="text-secondary pe-lg-5 mb-4">
                        Helping professionals format and optimize their resumes for standard applicant tracking systems.
                    </p>
                    
                    <!-- Social Links -->
                    <div class="d-flex gap-3">
                        <a href="https://www.instagram.com/_miral_patel_13?igsh=MTA2cG9hNTdpMzFxYw==" class="social-icon-link text-decoration-none" aria-label="Instagram">
                            <i class="bi bi-instagram fs-5"></i>
                        </a>
                        <a href="https://www.linkedin.com/in/miral-abhangi-a17b54391/" target="_blank" rel="noopener noreferrer" class="social-icon-link text-decoration-none" aria-label="LinkedIn">
                            <i class="bi bi-linkedin fs-5"></i>
                        </a>
                        <a href="https://www.facebook.com/share/1Ccy2F2ir9/" class="social-icon-link text-decoration-none" aria-label="Facebook">
                            <i class="bi bi-facebook fs-5"></i>
                        </a>
                    </div>
                </div>
                
                <div class="col-lg-4 col-md-6">
                    <h6 class="fw-bold mb-3">Company</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2">
                        <li><a href="#" class="text-secondary text-decoration-none hover-primary">About</a></li>
                        <li><a href="#" class="text-secondary text-decoration-none hover-primary">Contact</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-6">
                    <h6 class="fw-bold mb-3">Legal</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2">
                        <li><a href="#" class="text-secondary text-decoration-none hover-primary">Privacy Policy</a></li>
                        <li><a href="#" class="text-secondary text-decoration-none hover-primary">Terms of Service</a></li>
                    </ul>
                </div>
            </div>
            <div class="border-top mt-5 pt-4 text-center text-muted small">
                &copy; <span id="year"></span> ResuMax. All rights reserved.
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Vanilla JS Interactivity -->
    <script>
        // Set dynamic year
        document.getElementById('year').textContent = new Date().getFullYear();

        // Navbar scroll effect
        const navbar = document.getElementById('mainNav');
        window.addEventListener('scroll', () => {
            if (window.scrollY > 50) {
                navbar.classList.add('scrolled');
            } else {
                navbar.classList.remove('scrolled');
            }
        });
    </script>
</body>
</html>