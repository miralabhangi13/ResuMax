<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Set New Password | ResuMax</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    
    <!-- Custom CSS -->
    <style>
        :root {
            --bs-primary: #4F46E5;
            --primary-blue: #3B82F6;
            --primary-purple: #8B5CF6;
            --text-purple: #7C3AED;
            --surface-color: #ffffff;
            --bg-light: #f8fafc;
        }

        body {
            font-family: 'Inter', sans-serif;
            color: #1e293b;
            background-color: var(--bg-light);
            position: relative;
            overflow-x: hidden;
            min-height: 100vh;
        }

        /* Typography & Gradients */
        .text-gradient {
            background: linear-gradient(135deg, var(--primary-blue), var(--primary-purple));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .btn-gradient {
            background: linear-gradient(135deg, var(--primary-blue), var(--primary-purple));
            border: none;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            color: white;
        }

        .btn-gradient:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(79, 70, 229, 0.3);
            color: white;
        }
        
        .btn-gradient:disabled {
            background: #94a3b8;
            cursor: not-allowed;
            opacity: 0.7;
        }

        /* Background Blobs */
        .blob {
            position: absolute;
            filter: blur(80px);
            z-index: 0;
            border-radius: 50%;
            opacity: 0.4;
        }

        .shape-1 {
            top: -10%;
            left: -10%;
            width: 400px;
            height: 400px;
            background: var(--primary-blue);
        }

        .shape-2 {
            bottom: -10%;
            right: -10%;
            width: 350px;
            height: 350px;
            background: var(--primary-purple);
        }

        /* Auth Card */
        .auth-container {
            position: relative;
            z-index: 1;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
        }

        .auth-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            border-radius: 1.5rem;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            width: 100%;
            max-width: 450px;
            padding: 2.5rem;
        }

        /* Custom Inputs */
        .form-control {
            padding: 0.75rem 1rem;
            border-radius: 0.5rem;
            border: 1px solid #cbd5e1;
            background-color: #f8fafc;
            transition: all 0.2s;
        }

        .form-control:focus {
            background-color: #ffffff;
            border-color: var(--primary-purple);
            box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.1);
        }
        
        .form-control.is-invalid {
            border-color: #ef4444;
        }
        
        .form-control.is-valid {
            border-color: #10b981;
        }

        .form-label {
            font-weight: 500;
            font-size: 0.875rem;
            color: #475569;
            margin-bottom: 0.5rem;
        }

        .password-toggle {
            cursor: pointer;
            color: #64748b;
        }

        /* Password Rules */
        .password-rules {
            font-size: 0.8rem;
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }

        .rule-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: #64748b;
            transition: color 0.3s ease;
        }

        .rule-item.valid {
            color: #10b981;
        }

        /* Icon wrapper for the header */
        .icon-circle-header {
            width: 56px;
            height: 56px;
            background: rgba(16, 185, 129, 0.1);
            color: #10b981;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.25rem auto;
            font-size: 1.5rem;
        }

        /* Custom Alert Notification */
        .custom-toast {
            position: fixed;
            top: 24px;
            left: 50%;
            transform: translate(-50%, -150%);
            background-color: #ffffff;
            padding: 1rem 1.25rem;
            border-radius: 0.75rem;
            box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1), 0 8px 10px -6px rgba(0,0,0,0.1);
            display: flex;
            align-items: center;
            gap: 0.75rem;
            z-index: 9999;
            width: 90%;
            max-width: 400px;
            transition: transform 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
            border: 1px solid rgba(239, 68, 68, 0.2);
            pointer-events: none;
        }

        .custom-toast.show {
            transform: translate(-50%, 0);
        }

        .custom-toast .icon-wrapper {
            background-color: #fef2f2;
            color: #ef4444;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .custom-toast .message {
            color: #0f172a;
            font-size: 0.875rem;
            font-weight: 500;
            line-height: 1.4;
        }
    </style>
</head>
<body>

    <!-- Custom Toast Notification -->
    <div id="customToast" class="custom-toast">
        <div class="icon-wrapper">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </div>
        <div class="message" id="toastMessage"></div>
    </div>

    <!-- Background decorative elements -->
    <div class="blob shape-1"></div>
    <div class="blob shape-2"></div>

    <div class="auth-container">
        <div class="auth-card">
            <!-- Header -->
            <div class="text-center mb-4">
                <div class="icon-circle-header">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <h1 class="h4 fw-bold text-dark mb-2">Set New Password</h1>
                <p class="text-secondary small">Your identity has been verified. Please create a new password below.</p>
            </div>

            <!-- Password Reset Form -->
            <form action="/update-password" method="POST" id="resetForm">
                
                <!-- Hidden inputs (you usually need to pass the email or a reset token here) -->
                <input type="hidden" name="email" value="<%= typeof email !== 'undefined' ? email : '' %>">
                <input type="hidden" name="token" value="<%= typeof token !== 'undefined' ? token : '' %>">

                <!-- New Password -->
                <div class="mb-4">
                    <label for="newPassword" class="form-label">New Password</label>
                    <div class="input-group mb-2">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-lock"></i>
                        </span>
                        <input type="password" class="form-control border-start-0 border-end-0 ps-0" id="newPassword" name="newPassword" placeholder="Enter new password" required>
                        <span class="input-group-text bg-white border-start-0 password-toggle" onclick="togglePassword('newPassword', 'toggleIcon1')">
                            <i class="bi bi-eye" id="toggleIcon1"></i>
                        </span>
                    </div>

                    <!-- Dynamic Password Rules -->
                    <div class="password-rules mt-2" id="passwordRules">
                        <div class="rule-item" id="rule-length">
                            <i class="bi bi-circle"></i> At least 8 characters
                        </div>
                        <div class="rule-item" id="rule-upper">
                            <i class="bi bi-circle"></i> One uppercase letter
                        </div>
                        <div class="rule-item" id="rule-lower">
                            <i class="bi bi-circle"></i> One lowercase letter
                        </div>
                        <div class="rule-item" id="rule-number">
                            <i class="bi bi-circle"></i> One number
                        </div>
                        <div class="rule-item" id="rule-special">
                            <i class="bi bi-circle"></i> One special character (!@#$%^&*)
                        </div>
                    </div>
                </div>

                <!-- Confirm Password -->
                <div class="mb-4">
                    <label for="confirmPassword" class="form-label">Confirm Password</label>
                    <div class="input-group mb-1">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-check2-circle"></i>
                        </span>
                        <input type="password" class="form-control border-start-0 border-end-0 ps-0" id="confirmPassword" name="confirmPassword" placeholder="Confirm new password" required>
                        <span class="input-group-text bg-white border-start-0 password-toggle" onclick="togglePassword('confirmPassword', 'toggleIcon2')">
                            <i class="bi bi-eye" id="toggleIcon2"></i>
                        </span>
                    </div>
                    <!-- Error message for mismatch -->
                    <div id="matchError" class="text-danger small d-none mt-1">
                        <i class="bi bi-exclamation-circle me-1"></i> Passwords do not match
                    </div>
                </div>

                <!-- Submit Button (Disabled by default) -->
                <button type="submit" class="btn btn-gradient w-100 rounded-pill py-2 fw-medium mb-4" id="submitBtn" disabled>
                    Update Password
                </button>
            </form>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Vanilla JS Interactivity -->
    <script>
        // --- 1. Custom Toast Logic ---
        let toastTimeout;
        function showToast(message) {
            const errorMsg = Array.isArray(message) ? message[0] : message;
            const toast = document.getElementById('customToast');
            const msgEl = document.getElementById('toastMessage');
            
            msgEl.textContent = errorMsg;
            toast.classList.add('show');
            
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.remove('show');
            }, 3500);
        }

        // --- 2. Toggle Password Visibility ---
        function togglePassword(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }

        // --- 3. Password Validation & Match Logic ---
        const newPassword = document.getElementById('newPassword');
        const confirmPassword = document.getElementById('confirmPassword');
        const submitBtn = document.getElementById('submitBtn');
        const matchError = document.getElementById('matchError');
        const form = document.getElementById('resetForm');

        // Regex patterns for validation
        const rules = {
            length: { regex: /.{8,}/, element: document.getElementById('rule-length') },
            upper: { regex: /[A-Z]/, element: document.getElementById('rule-upper') },
            lower: { regex: /[a-z]/, element: document.getElementById('rule-lower') },
            number: { regex: /[0-9]/, element: document.getElementById('rule-number') },
            special: { regex: /[^A-Za-z0-9]/, element: document.getElementById('rule-special') }
        };

        let isPasswordValid = false;

        function validateForm() {
            const val1 = newPassword.value;
            const val2 = confirmPassword.value;

            // 1. Check rules for New Password
            isPasswordValid = true;
            for (const key in rules) {
                const rule = rules[key];
                const isValid = rule.regex.test(val1);
                const icon = rule.element.querySelector('i');

                if (isValid) {
                    rule.element.classList.add('valid');
                    icon.classList.remove('bi-circle');
                    icon.classList.add('bi-check-circle-fill');
                } else {
                    rule.element.classList.remove('valid');
                    icon.classList.remove('bi-check-circle-fill');
                    icon.classList.add('bi-circle');
                    isPasswordValid = false;
                }
            }

            if (val1.length > 0) {
                if (isPasswordValid) {
                    newPassword.classList.remove('is-invalid');
                    newPassword.classList.add('is-valid');
                } else {
                    newPassword.classList.remove('is-valid');
                    newPassword.classList.add('is-invalid');
                }
            } else {
                newPassword.classList.remove('is-valid', 'is-invalid');
            }

            // 2. Check if Confirm Password matches
            let isMatch = false;
            
            if (val2.length === 0) {
                confirmPassword.classList.remove('is-valid', 'is-invalid');
                matchError.classList.add('d-none');
            } else if (val1 === val2) {
                confirmPassword.classList.remove('is-invalid');
                confirmPassword.classList.add('is-valid');
                matchError.classList.add('d-none');
                isMatch = true;
            } else {
                confirmPassword.classList.remove('is-valid');
                confirmPassword.classList.add('is-invalid');
                matchError.classList.remove('d-none');
            }

            // 3. Enable/Disable Submit Button
            if (isPasswordValid && isMatch) {
                submitBtn.disabled = false;
            } else {
                submitBtn.disabled = true;
            }
        }

        // Run checks whenever either input changes
        newPassword.addEventListener('input', validateForm);
        confirmPassword.addEventListener('input', validateForm);

        // Fallback prevent default just in case
        form.addEventListener('submit', (e) => {
            if (!isPasswordValid || (newPassword.value !== confirmPassword.value)) {
                e.preventDefault();
                showToast("Please ensure your password meets all rules and matches.");
            }
        });
    </script>

    <!-- EJS Logic to Catch Backend Errors -->
    <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                showToast(<%- JSON.stringify(error) %>);
            });
        </script>
    <% } %>
</body>
</html>