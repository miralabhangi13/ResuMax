<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Log In | ResuMax</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Custom CSS -->
    <style>
        :root {
            --bs-primary: #4F46E5;
            --primary-blue: #3B82F6;
            --primary-purple: #8B5CF6;
            --text-purple: #7C3AED;
            --surface-color: #ffffff;
            --bg-light: #f8fafc;
        }

        body {
            font-family: 'Inter', sans-serif;
            color: #1e293b;
            background-color: var(--bg-light);
            position: relative;
            overflow-x: hidden;
            min-height: 100vh;
        }

        /* Typography & Gradients */
        .text-gradient {
            background: linear-gradient(135deg, var(--primary-blue), var(--primary-purple));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .btn-gradient {
            background: linear-gradient(135deg, var(--primary-blue), var(--primary-purple));
            border: none;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            color: white;
        }

        .btn-gradient:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(79, 70, 229, 0.3);
            color: white;
        }

        /* Background Blobs */
        .blob {
            position: absolute;
            filter: blur(80px);
            z-index: 0;
            border-radius: 50%;
            opacity: 0.4;
        }

        .shape-1 {
            top: -10%;
            left: -10%;
            width: 400px;
            height: 400px;
            background: var(--primary-blue);
        }

        .shape-2 {
            bottom: -10%;
            right: -10%;
            width: 350px;
            height: 350px;
            background: var(--primary-purple);
        }

        /* Auth Card */
        .auth-container {
            position: relative;
            z-index: 1;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
        }

        .auth-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            border-radius: 1.5rem;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            width: 100%;
            max-width: 450px;
            padding: 2.5rem;
        }

        /* Custom Inputs */
        .form-control {
            padding: 0.75rem 1rem;
            border-radius: 0.5rem;
            border: 1px solid #cbd5e1;
            background-color: #f8fafc;
            transition: all 0.2s;
        }

        .form-control:focus {
            background-color: #ffffff;
            border-color: var(--primary-purple);
            box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.1);
        }

        .form-label {
            font-weight: 500;
            font-size: 0.875rem;
            color: #475569;
            margin-bottom: 0.5rem;
        }

        /* Google Button */
        .btn-google {
            background-color: #ffffff;
            border: 1px solid #cbd5e1;
            color: #334155;
            font-weight: 500;
            transition: all 0.2s ease;
        }

        .btn-google:hover {
            background-color: #f8fafc;
            border-color: #94a3b8;
            color: #0f172a;
        }

        /* Divider */
        .divider {
            display: flex;
            align-items: center;
            text-align: center;
            margin: 1.5rem 0;
            color: #64748b;
            font-size: 0.875rem;
        }

        .divider::before,
        .divider::after {
            content: '';
            flex: 1;
            border-bottom: 1px solid #e2e8f0;
        }

        .divider:not(:empty)::before {
            margin-right: .25em;
        }

        .divider:not(:empty)::after {
            margin-left: .25em;
        }

        .hover-link {
            color: var(--bs-primary);
            text-decoration: none;
            font-weight: 500;
            transition: color 0.2s;
        }

        .hover-link:hover {
            color: var(--primary-purple);
            text-decoration: underline;
        }

        .password-toggle {
            cursor: pointer;
            color: #64748b;
        }

        .forgot-password {
            font-size: 0.875rem;
            text-decoration: none;
            color: var(--bs-primary);
            font-weight: 500;
        }

        .forgot-password:hover {
            color: var(--primary-purple);
            text-decoration: underline;
        }

        /* Custom Alert Notification */
        .custom-toast {
            position: fixed;
            top: 24px;
            left: 50%;
            transform: translate(-50%, -150%);
            background-color: #ffffff;
            padding: 1rem 1.25rem;
            border-radius: 0.75rem;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
            display: flex;
            align-items: center;
            gap: 0.75rem;
            z-index: 9999;
            width: 90%;
            max-width: 400px;
            transition: transform 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
            border: 1px solid rgba(239, 68, 68, 0.2);
            pointer-events: none;
        }

        .custom-toast.show {
            transform: translate(-50%, 0);
        }

        .custom-toast .icon-wrapper {
            background-color: #fef2f2;
            color: #ef4444;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .custom-toast .message {
            color: #0f172a;
            font-size: 0.875rem;
            font-weight: 500;
            line-height: 1.4;
        }
    </style>
</head>

<body>

    <!-- Custom Toast Notification -->
    <div id="customToast" class="custom-toast">
        <div class="icon-wrapper">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </div>
        <div class="message" id="toastMessage"></div>
    </div>

    <!-- Background decorative elements -->
    <div class="blob shape-1"></div>
    <div class="blob shape-2"></div>

    <div class="auth-container">
        <div class="auth-card">
            <!-- Header -->
            <div class="text-center mb-4">
                <a href="/" class="text-decoration-none">
                    <h2 class="fw-bold fs-2 text-gradient mb-3">ResuMax</h2>
                </a>
                <h1 class="h4 fw-bold text-dark mb-2">Welcome back</h1>
                <p class="text-secondary small">Log in to your account to continue.</p>
            </div>

            <!-- Google OAuth Button -->
            <a href="/auth/google"
                class="btn btn-google w-100 rounded-pill py-2 mb-3 d-flex align-items-center justify-content-center gap-2">
                <i class="bi bi-google text-danger"></i>
                <span>Continue with Google</span>
            </a>

            <!-- Divider -->
            <div class="divider text-muted px-2">or log in with email</div>

            <!-- Login Form -->
            <form action="/login" method="POST">

                <!-- Email -->
                <div class="mb-3">
                    <label for="email" class="form-label">Email address</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-envelope"></i>
                        </span>
                        <input type="email" class="form-control border-start-0 ps-0" id="email" name="email" value="<%= typeof email !== 'undefined' ? email : '' %>"
                            placeholder="name@example.com" required>
                    </div>
                </div>

                <!-- Password -->
                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label for="password" class="form-label mb-0">Password</label>
                        <a href="/forgot-password" class="forgot-password">Forgot password?</a>
                    </div>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-lock"></i>
                        </span>
                        <input type="password" class="form-control border-start-0 border-end-0 ps-0" id="password"
                            name="password" placeholder="Enter your password" required>
                        <span class="input-group-text bg-white border-start-0 password-toggle"
                            onclick="togglePassword()">
                            <i class="bi bi-eye" id="toggleIcon"></i>
                        </span>
                    </div>
                </div>
                <!-- Submit Button -->
                <button type="submit" class="btn btn-gradient w-100 rounded-pill py-2 fw-medium mb-4">
                    Log In
                </button>
            </form>
            <% if (typeof showVerifyButton !== "undefined" && showVerifyButton) { %>
                <form action="/resend-verification-otp" method="POST" class="mt-3">
                    <input type="hidden" name="email" value="<%= email %>">
                    <button type="submit" class="btn btn-outline-primary w-100 rounded-pill">
                        Resend Verification Code
                    </button>
                </form>
                <% } %>

                    <!-- Footer Link -->
                    <p class="text-center text-secondary small mb-0">
                        Don't have an account? <a href="/signup" class="hover-link">Sign up</a>
                    </p>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Vanilla JS -->
    <script>
        function togglePassword() {
            const passwordInput = document.getElementById('password');
            const toggleIcon = document.getElementById('toggleIcon');

            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleIcon.classList.remove('bi-eye');
                toggleIcon.classList.add('bi-eye-slash');
            } else {
                passwordInput.type = 'password';
                toggleIcon.classList.remove('bi-eye-slash');
                toggleIcon.classList.add('bi-eye');
            }
        }

        // Custom Toast function
        let toastTimeout;
        function showToast(message) {
            // Ensure message is rendered properly even if it's passed as an array by flash
            const errorMsg = Array.isArray(message) ? message[0] : message;

            const toast = document.getElementById('customToast');
            const msgEl = document.getElementById('toastMessage');

            msgEl.textContent = errorMsg;
            toast.classList.add('show');

            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.remove('show');
            }, 3500); // Hide after 3.5 seconds
        }
    </script>

    <!-- EJS Logic to Catch Passport Errors -->
    <!-- EJS Logic to Catch Passport Errors -->
    <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                showToast(<%- JSON.stringify(error) %>);
            });
        </script>
    <% } else if (typeof messages !== 'undefined' && messages.error) { %>
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                showToast(<%- JSON.stringify(messages.error) %>);
            });
        </script>
    <% } else if (typeof success !== 'undefined' && success && success.length > 0) { %>
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                const toast = document.getElementById('customToast');
                const icon = toast.querySelector('.icon-wrapper');
                icon.innerHTML = '<i class="bi bi-check-circle-fill"></i>';
                icon.style.backgroundColor = '#d1fae5';
                icon.style.color = '#10b981';
                toast.style.borderColor = 'rgba(16, 185, 129, 0.2)';
                showToast(<%- JSON.stringify(success) %>);
            });
        </script>
    <% } %>
</body>
</html>
</html>